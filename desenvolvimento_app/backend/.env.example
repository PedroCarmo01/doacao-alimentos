# ======================================================================
# Configuração do backend. Copie este arquivo para ".env" (mesma pasta):
#   PowerShell:  Copy-Item .env.example .env
# O ".env" NUNCA vai para o Git (está no .gitignore): ele tem senhas.
# ======================================================================

# --- Banco de dados (MySQL 8.4) ---------------------------------------
DB_HOST=127.0.0.1
DB_PORTA=3306
DB_NOME=summit
DB_USUARIO=summit_app
# A mesma senha usada em database/criar_usuario.sql
DB_SENHA=TroqueEstaSenha_123
# Conexão segura (TLS), exigida pelo login padrão do MySQL 8.4. Deixe true.
DB_TLS=true

# --- Autenticação (JWT) -----------------------------------------------
# Segredo que assina os tokens: aleatório, com no mínimo 32 caracteres.
# Cada pessoa gera o seu. Gere no PowerShell com:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
JWT_SEGREDO=
JWT_VALIDADE_HORAS=12

# --- Regras de negócio ------------------------------------------------
# Prazo para a ONG retirar a doação reservada, em minutos.
# Para demonstrar a expiração na apresentação, use 2.
RESERVA_MINUTOS=120
# Raio padrão (km) da busca de doações próximas.
RAIO_PADRAO_KM=10
# Diferença em horas para o UTC, usada para decidir qual é o dia de "hoje".
# Brasília = -3.
FUSO_HORARIO=-3

# --- Servidor ---------------------------------------------------------
# Origem permitida pelo CORS (só importa se o app rodar no Chrome).
CORS_ORIGEM=*
# true = aceita conexões da rede local (necessário para testar em
# celular físico). Em false, só o próprio computador e o emulador acessam.
ESCUTAR_NA_REDE=false
