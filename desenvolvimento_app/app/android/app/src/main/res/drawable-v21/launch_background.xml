<?xml version="1.0" encoding="utf-8"?>
<!-- Tela de abertura nativa (etapa 8): aparece enquanto o Flutter carrega.
     Fundo da cor do tema e a logo do app no centro. A imagem
     logo_abertura.png é gerada a partir de assets/imagens/logo.png. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/logo_abertura" />
    </item>
</layer-list>
